{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.demo.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "m-charts": ["../../packages/m-charts/src/index.ts"],
      "m-charts/plot-engine": ["../../packages/m-charts/src/plot-engine/index.ts"],
      "m-charts/plot-engine-webgpu": ["../../packages/m-charts/src/plot-engine-webgpu/index.ts"],
      "m-charts/m-scatter": ["../../packages/m-charts/src/m-scatter/index.ts"],
      "m-charts/m-scatter-webgpu": ["../../packages/m-charts/src/m-scatter-webgpu/index.ts"],
      "m-charts/m-parallel": ["../../packages/m-charts/src/m-parallel/index.ts"],
      "m-charts/m-histogram": ["../../packages/m-charts/src/m-histogram/index.ts"],
      "m-charts/scatter": ["../../packages/m-charts/src/m-scatter/index.ts"],
      "m-charts/parallel": ["../../packages/m-charts/src/m-parallel/index.ts"],
      "m-charts/histogram": ["../../packages/m-charts/src/m-histogram/index.ts"]
    }
  },
  "include": ["src"]
}
