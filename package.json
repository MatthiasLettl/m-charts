{
  "name": "m-charts-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "WebGL2 and WebGPU charting library for large datasets, with high-performance scatter, histogram, and parallel-coordinate interactions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthiasLettl/m-charts.git"
  },
  "bugs": {
    "url": "https://github.com/MatthiasLettl/m-charts/issues"
  },
  "homepage": "https://github.com/MatthiasLettl/m-charts#readme",
  "keywords": [
    "webgl2",
    "webgpu",
    "charts",
    "visualization",
    "scatterplot",
    "histogram",
    "parallel-coordinates",
    "typescript"
  ],
  "scripts": {
    "dev": "pnpm --filter @m-charts/demo dev",
    "build": "pnpm check:aggregation-wasm && pnpm --filter m-charts build && pnpm --filter @m-charts/demo build",
    "build:aggregation-wasm": "tsx scripts/build-scatter-wasm.ts",
    "check:aggregation-wasm": "tsx scripts/build-scatter-wasm.ts --check",
    "build:scatter-wasm": "tsx scripts/build-scatter-wasm.ts",
    "check:scatter-wasm": "tsx scripts/build-scatter-wasm.ts --check",
    "lint:rust": "tsx scripts/check-scatter-rust.ts",
    "build:vercel": "pnpm clean:data && pnpm generate:data:local && pnpm --filter m-charts build && pnpm --filter @m-charts/demo build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --filter m-charts build && tsx tests/unit/run-tests.ts",
    "test:e2e": "playwright test",
    "clean:data": "rm -f apps/demo/public/data/*",
    "generate:data": "tsx scripts/generate-data.ts",
    "generate:data:webgpu": "pnpm generate:data -- --kind scatter-webgpu --count 10000000 --page-size 250000 --seed 1 --out apps/demo/public/data/scatter-webgpu-10m.json --schema-out apps/demo/public/data/scatter-fast-schema.json",
    "generate:data:webgpu:25m": "pnpm generate:data -- --kind scatter-webgpu --count 25000000 --page-size 250000 --seed 1 --out apps/demo/public/data/scatter-webgpu-25m.json --schema-out apps/demo/public/data/scatter-fast-schema.json",
    "generate:data:local": "pnpm generate:data -- --kind scatter-fast --count 1000000 --seed 1 --out apps/demo/public/data/scatter-fast-sample.json --schema-out apps/demo/public/data/scatter-fast-schema.json && pnpm generate:data -- --kind mixed-tables --count 1000000 --secondary-count 1000 --secondary-out apps/demo/public/data/mixed-table-fixture.secondary.json --seed 1 --out apps/demo/public/data/mixed-table-fixture.json && pnpm generate:data -- --kind histogram-bars --seed 1 --out apps/demo/public/data/histogram-bars-sample.json && pnpm generate:data -- --kind scatter --count 1000000 --seed 1 --out apps/demo/public/data/scatter-sample.json && pnpm generate:data -- --kind parallel --count 100000 --seed 1 --out apps/demo/public/data/parallel-sample.json",
    "benchmark:scatter:custom": "tsx scripts/benchmark-scatter-performance-gate.ts --target custom",
    "benchmark:scatter:webgpu": "tsx scripts/benchmark-scatter-webgpu-performance-gate.ts",
    "benchmark:parallel:custom": "tsx scripts/benchmark-parallel-performance-gate.ts --target custom",
    "benchmark:histogram:custom": "tsx scripts/benchmark-histogram-performance-gate.ts",
    "benchmark:histogram:webgpu": "tsx scripts/benchmark-histogram-webgpu-aggregation.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@webgpu/types": "^0.1.71",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "m-charts": "workspace:*",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.3"
  },
  "packageManager": "pnpm@11.7.0"
}
